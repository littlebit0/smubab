# Server
PORT=8000
HOST=0.0.0.0

# Cache database
MENU_DB_PATH=./smubab.db
# DATABASE_URL=sqlite:///./smubab.db

# Menu cache refresh
# Weekdays cache the current week. Weekends poll more often for next week's post.
MENU_UPDATE_INTERVAL_SECONDS=21600
MENU_WEEKEND_UPDATE_INTERVAL_SECONDS=3600

# Web push
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@smubab.app
